# Bu dosyayı ".env.local" adıyla kopyalayıp değerleri doldur.
# .env.local asla git'e eklenmez.

# Tarayıcıda kullanılabilir (herkese açık) değerler
# Supabase > Project Settings > API Keys > Publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# GİZLİ – sadece sunucu tarafında kullanılır, asla NEXT_PUBLIC_ ile başlatma
# (Şimdilik gerekmiyor; ileride gerekirse Supabase > API Keys > Secret key)
SUPABASE_SECRET_KEY=
